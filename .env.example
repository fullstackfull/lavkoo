SOFTWARE_ID=MzE0NDg1OTc=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

NGINX_PORT=8302
FORCE_HTTPS=true
CONTAINER_NAME_PREFIX=6valley-demo

# Multi-provider fulfillment (M5AZN, Torod Point). Credentials are NOT set here: enter them in the admin
# panel (Fulfillment providers) where they are stored encrypted. Everything below is off / safe by default.
FULFILLMENT_INTEGRATIONS_ENABLED=false
# Independent of the line above: even when integrations are enabled, NOTHING is written to a provider (no order, product or
# cancellation is sent) unless this is true. Keep it false on staging and until a deliberate go-live.
FULFILLMENT_EXTERNAL_WRITES_ENABLED=false
FULFILLMENT_CURRENCY=SAR
FULFILLMENT_QUEUE_CONNECTION=
FULFILLMENT_QUEUE=fulfillment
# Fulfillment jobs may run up to 120 s; the queue must not hand a running job to a second worker.
QUEUE_RETRY_AFTER=180
FULFILLMENT_ALLOW_MIXED_COD=false

# Proxies whose X-Forwarded-* headers are believed (comma-separated addresses/CIDRs; '*' only if the app is reachable
# solely through the proxy). Empty trusts none. Read by config/trustedproxy.php; the webhook rate limit and an IP
# allow-list need the real client address.
TRUSTED_PROXIES=
