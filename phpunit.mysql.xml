<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same suites as phpunit.xml, but against a real MySQL server.

    phpunit.xml pins DB_CONNECTION=sqlite with <server>, which OVERRIDES the environment: a CI job that exports
    DB_CONNECTION=mysql still ran on in-memory SQLite (tests/Feature/CiDatabaseTest caught it). This file leaves the
    database to the environment: DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD come from
    the CI job, and the schema helper refuses to touch a database whose name does not contain "test".
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>

        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist processUncoveredFilesFromWhitelist="true">
            <directory suffix=".php">./app</directory>
        </whitelist>
    </filter>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <!-- The cost module ships off (config/operational_costs.php); its tests run with the master switch on and say so where they test the off state. -->
        <server name="OPERATIONAL_COSTS_ENABLED" value="true"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="MAIL_DRIVER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
